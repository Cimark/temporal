---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config/site';
---

<Layout
  title={`Política de privacidad | ${siteConfig.name}`}
  description={`Política de privacidad y tratamiento de datos de ${siteConfig.name}.`}
>
  <Header />
  <main class="mx-auto max-w-3xl px-4 py-16 sm:px-6 text-white/80 leading-relaxed space-y-4">
    <h1 class="text-3xl font-bold text-white">Política de privacidad</h1>
    <p>
      {siteConfig.name} recopila datos de contacto que nos envías voluntariamente (correo, teléfono,
      mensajes) para responder consultas comerciales.
    </p>
    <p>
      Utilizamos Google Analytics 4 para medir el uso del sitio de forma agregada. Consulta nuestra
      <a href="/cookies" class="text-eco-500 underline">política de cookies</a>.
    </p>
    <p>
      Para ejercer derechos ARCO o consultas sobre tus datos, escribe a{' '}
      <a href={`mailto:${siteConfig.email}`} class="text-eco-500 underline">{siteConfig.email}</a>.
    </p>
  </main>
  <Footer />
</Layout>
