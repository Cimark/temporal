---
import SectionShell from './SectionShell.astro';
import SectionHeading from './SectionHeading.astro';
import PlantGrowIcon from './PlantGrowIcon.astro';
import MethodStepIcon from './MethodStepIcon.astro';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import { methodology, methodologyContact } from '../data/landing';
import { formatPeruPhone, siteConfig, whatsappUrl } from '../config/site';

const timelineSteps = [...methodology, methodologyContact];
const phoneDisplay = formatPeruPhone(siteConfig.whatsapp);
---

<SectionShell id="metodologia" tone="muted" padding="px-4 pt-8 pb-16 sm:px-6 sm:pt-10 lg:pb-20" innerClass="section-inner--wide">
  <div class="method-timeline">
    <div class="method-timeline__intro">
      <PlantGrowIcon size="md" class="method-timeline__mark" />
      <SectionHeading
        eyebrow="Cómo trabajamos"
        title="Metodología clara, resultados medibles"
        description="Sin procesos opacos: desde el primer diagnóstico hasta el reporte final, sabes qué hacemos, cuándo y para qué."
        tone="light"
        align="center"
      />
    </div>

    <div class="method-timeline__list-wrap">
      <div class="method-timeline__line" aria-hidden="true">
        <span class="method-timeline__line-track"></span>
        <span class="method-timeline__line-fill"></span>
      </div>

      <ol class="method-timeline__list">
        {
          timelineSteps.map((item, index) => (
            <li class="method-timeline__item" data-method-reveal style={`--step-i: ${index}`}>
              <div class="method-timeline__rail" aria-hidden="true">
                <span class="method-timeline__node" data-method-node>{item.step}</span>
              </div>
              {
                item.step === '05' ? (
                  <a
                    href={whatsappUrl(methodologyContact.whatsappMessage)}
                    class="method-timeline__card method-timeline__card--contact"
                    target="_blank"
                    rel="noopener noreferrer"
                    data-cta="methodology-whatsapp"
                    aria-label={`Contactar por WhatsApp: ${phoneDisplay}`}
                  >
                    <div class="method-timeline__card-body">
                      <h3 class="method-timeline__card-title">{item.title}</h3>
                      <p class="method-timeline__card-desc">{item.desc}</p>
                      <div class="method-timeline__card-actions">
                        <span class="method-timeline__phone">
                          <WhatsAppIcon class="method-timeline__phone-icon" />
                          {phoneDisplay}
                        </span>
                      </div>
                    </div>
                  </a>
                ) : (
                  <article class="method-timeline__card">
                    <span class="method-timeline__card-icon">
                      <MethodStepIcon icon={item.icon} />
                    </span>
                    <div class="method-timeline__card-body">
                      <h3 class="method-timeline__card-title">{item.title}</h3>
                      <p class="method-timeline__card-desc">{item.desc}</p>
                    </div>
                  </article>
                )
              }
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</SectionShell>

<script>
  function clamp(value: number, min: number, max: number) {
    return Math.min(max, Math.max(min, value));
  }

  function initMethodTimeline() {
    const roots = document.querySelectorAll<HTMLElement>('.method-timeline');
    if (!roots.length) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    roots.forEach((root) => {
      if (root.dataset.methodTimelineReady === '1') return;
      root.dataset.methodTimelineReady = '1';

      const wrap = root.querySelector<HTMLElement>('.method-timeline__list-wrap');
      const line = root.querySelector<HTMLElement>('.method-timeline__line');
      const nodes = root.querySelectorAll<HTMLElement>('[data-method-node]');
      const items = root.querySelectorAll<HTMLElement>('[data-method-reveal]');
      if (!wrap || !line || !nodes.length) return;

      const layoutLine = () => {
        const first = nodes[0].getBoundingClientRect();
        const last = nodes[nodes.length - 1].getBoundingClientRect();
        const wrapRect = wrap.getBoundingClientRect();
        const top = first.top + first.height / 2 - wrapRect.top;
        const height = last.top + last.height / 2 - (first.top + first.height / 2);

        line.style.top = `${top}px`;
        line.style.height = `${Math.max(height, 0)}px`;
      };

      const updateLineProgress = () => {
        const first = nodes[0].getBoundingClientRect();
        const last = nodes[nodes.length - 1].getBoundingClientRect();
        const lineStart = first.top + first.height / 2;
        const lineEnd = last.top + last.height / 2;
        const span = lineEnd - lineStart;

        if (span <= 0) {
          root.style.setProperty('--timeline-progress', '1');
          nodes.forEach((node) => node.classList.add('is-active'));
          return;
        }

        const anchor = window.innerHeight * 0.52;
        const progress = clamp((anchor - lineStart) / span, 0, 1);
        root.style.setProperty('--timeline-progress', progress.toFixed(3));

        nodes.forEach((node, index) => {
          const threshold = index / Math.max(nodes.length - 1, 1);
          node.classList.toggle('is-active', progress >= threshold - 0.02);
        });
      };

      const refresh = () => {
        layoutLine();
        updateLineProgress();
      };

      if (reducedMotion) {
        items.forEach((item) => item.classList.add('is-visible'));
        root.style.setProperty('--timeline-progress', '1');
        nodes.forEach((node) => node.classList.add('is-active'));
        refresh();
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
              requestAnimationFrame(refresh);
            }
          });
        },
        { threshold: 0.22, rootMargin: '0px 0px -6% 0px' },
      );

      items.forEach((item) => observer.observe(item));

      refresh();
      window.addEventListener('scroll', refresh, { passive: true });
      window.addEventListener('resize', refresh, { passive: true });

      if ('ResizeObserver' in window) {
        const resizeObserver = new ResizeObserver(refresh);
        resizeObserver.observe(wrap);
      }
    });
  }

  initMethodTimeline();
  document.addEventListener('astro:page-load', initMethodTimeline);
</script>
