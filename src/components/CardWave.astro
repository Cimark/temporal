---
interface Props {
  fill?: string;
  class?: string;
}

const { fill = '#ffffff', class: className = '' } = Astro.props;
---

<svg
  class:list={['pointer-events-none absolute -bottom-px left-0 z-20 h-5 w-full sm:h-6', className]}
  viewBox="0 0 1440 48"
  preserveAspectRatio="none"
  aria-hidden="true"
>
  <path
    fill={fill}
    d="M0,28 C240,52 480,8 720,28 C960,48 1200,12 1440,28 L1440,48 L0,48 Z"
  />
</svg>
