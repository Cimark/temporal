---
import SectionShell from './SectionShell.astro';
import SectionHeading from './SectionHeading.astro';
import CardWave from './CardWave.astro';
import CardBrandMark from './icons/CardBrandMark.astro';
import CheckBullet from './icons/CheckBullet.astro';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import MailIcon from './icons/MailIcon.astro';
import { siteConfig, whatsappUrl } from '../config/site';
import { services, servicesSection } from '../data/landing';
import serviceCompliance from '../assets/service_compliance.png';
import sectorManufactura from '../assets/sector_manufactura.jpg';
import sectorMineria from '../assets/sector_mineria.jpg';

const serviceImages: Record<string, (typeof serviceCompliance)> = {
  permisos: serviceCompliance,
  residuos: sectorManufactura,
  monitoreo: sectorMineria,
};

const serviceIcons: Record<string, string> = {
  permisos:
    'M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z M14 2v6h6 M9 15l2 2 4-4',
  residuos: 'M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 11v6M14 11v6',
  monitoreo: 'M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z M12 15a3 3 0 100-6 3 3 0 000 6z',};
---

<SectionShell id="servicios" tone="light" innerClass="section-inner--wide">
  <SectionHeading
    eyebrow={servicesSection.eyebrow}
    title={servicesSection.title}
    description={servicesSection.description}
    tone="light"
    align="center"
    titleWide
  />

  <div class="services-grid mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
    {
      services.map((service) => {
        const serviceImage = serviceImages[service.slug];
        const iconPath = serviceIcons[service.slug];
        return (
          <article class="card-brand card-brand--service group">
            <div class="card-brand__media">
              <img
                src={serviceImage.src}
                alt={`${service.titlePrefix}${service.titleHighlight}`}
                width={serviceImage.width}
                height={serviceImage.height}
                class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <div class="card-brand__overlay" aria-hidden="true" />
              <p class="card-brand__eyebrow absolute left-5 top-5 z-10 rounded-full border border-eco-500/30 bg-eco-950 px-3 py-1">
                {service.tag}
              </p>
              <CardWave />
            </div>

            <div class="card-brand__body bg-white">
              <CardBrandMark />
              <div class="card-brand__content relative flex items-start gap-3">
                <span
                  class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-eco-500/25 bg-eco-500/10 text-eco-500"
                  aria-hidden="true"
                >
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                    <path d={iconPath} stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
                <div>
                  <h3 class="card-brand__title">
                    {service.titlePrefix}
                    <span class="card-brand__accent">{service.titleHighlight}</span>
                  </h3>
                  <p class="mt-3 text-sm leading-relaxed text-body-light sm:text-base">{service.desc}</p>
                </div>
              </div>

              <ul class="card-brand__bullets relative mt-6 space-y-3 border-t border-eco-950/10 pt-6">
                {
                  service.bullets.map((bullet) => (
                    <li class="flex items-start gap-3 text-sm text-eco-950">
                      <CheckBullet />
                      <span>{bullet}</span>
                    </li>
                  ))
                }
              </ul>

              <div class="card-brand__cta-wrap">
                <div class="card-cta-stack">
                  <a
                    href={whatsappUrl(service.whatsappMessage)}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="service-card-cta"
                    data-cta={`service-${service.slug}`}
                  >
                    <WhatsAppIcon class="service-card-cta__icon" />
                    <span>{service.cta}</span>
                  </a>
                  <button
                    type="button"
                    class="service-card-cta service-card-cta--email"
                    data-quote-open
                    data-quote-type="service"
                    data-quote-item={`${service.titlePrefix}${service.titleHighlight}`}
                    data-quote-to={siteConfig.emailServices}
                    data-cta={`service-email-${service.slug}`}
                  >
                    <MailIcon class="service-card-cta__icon" />
                    <span>Cotizar por correo</span>
                  </button>
                </div>
              </div>
            </div>
          </article>
        );
      })
    }
  </div>

  <div class="services-orient card-light mt-14 flex flex-col items-center justify-between gap-4 p-6 text-center sm:flex-row sm:text-left">
    <div class="inline-grid grid-cols-[auto_1fr] items-center gap-x-3 gap-y-1 text-left">
      <WhatsAppIcon class="row-span-2 block h-full w-10 max-h-[3.25rem] shrink-0 self-center text-[#25D366]" />
      <p class="text-lg font-bold text-eco-950">¿No sabes por dónde empezar?</p>
      <p class="text-sm text-body-light">
        Te orientamos en 15 minutos según tu industria y urgencia normativa.
      </p>
    </div>
    <a
      href={whatsappUrl('Hola, necesito orientación sobre qué servicio ambiental necesita mi empresa.')}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-primary inline-flex shrink-0 items-center gap-2"
      data-cta="services-orientation"
    >
      <WhatsAppIcon class="h-5 w-5 shrink-0" />
      <span>Consultoría gratuita</span>
    </a>
  </div>
</SectionShell>
