---
interface Props {
  icon: 'diagnosis' | 'plan' | 'implement' | 'measure' | 'contact';
  class?: string;
}

const { icon, class: className = '' } = Astro.props;
---

<svg
  class:list={['method-step__icon', className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    icon === 'diagnosis' ? (
      <>
        <path class="method-step__icon-draw" d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2" />
        <path class="method-step__icon-draw" d="M9 5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2" />
        <path class="method-step__icon-draw" d="M9 12h6M9 16h4" />
        <circle class="method-step__icon-draw" cx="17" cy="17" r="3" />
        <path class="method-step__icon-draw" d="m19.5 19.5 1 1" />
      </>
    ) : icon === 'plan' ? (
      <>
        <path class="method-step__icon-draw" d="M3 6.5 12 3l9 3.5-9 3.5-9-3.5Z" />
        <path class="method-step__icon-draw" d="M12 7v14" />
        <path class="method-step__icon-draw" d="M7 9.5v8.5l5 2 5-2V9.5" />
      </>
    ) : icon === 'implement' ? (
      <>
        <path class="method-step__icon-draw" d="M3 9l9-4 9 4-9 4-9-4Z" />
        <path class="method-step__icon-draw" d="M12 13v7" />
        <path class="method-step__icon-draw" d="M8 21h8" />
        <path class="method-step__icon-draw" d="M9 9.5V6.5l3-1.5 3 1.5v3" />
      </>
    ) : icon === 'contact' ? (
      <>
        <path class="method-step__icon-draw" d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92Z" />
      </>
    ) : (
      <>
        <path class="method-step__icon-draw" d="M4 19V5" />
        <path class="method-step__icon-draw" d="M4 19h16" />
        <path class="method-step__icon-draw" d="M8 17V11" />
        <path class="method-step__icon-draw" d="M12 17V8" />
        <path class="method-step__icon-draw" d="M16 17v-5" />
        <path class="method-step__icon-draw" d="M20 17V6" />
      </>
    )
  }
</svg>
