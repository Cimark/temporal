---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<span class:list={['method-plant', className]} aria-hidden="true">
  <svg class="method-plant__svg" viewBox="18 6 84 134" fill="none" xmlns="http://www.w3.org/2000/svg">
    <ellipse class="method-plant__soil" cx="60" cy="128" rx="26" ry="6" fill="currentColor" opacity="0.22" />
    <path
      class="method-plant__pot"
      d="M40 118c8-4 32-4 40 0v10c0 4-36 6-40 0v-10Z"
      fill="currentColor"
      opacity="0.3"
    />
    <path
      class="method-plant__stem"
      d="M60 118V38"
      stroke="currentColor"
      stroke-width="3.5"
      stroke-linecap="round"
    />

    <g class="method-plant__cluster method-plant__cluster--1">
      <path class="method-plant__twig" d="M60 98L28 80" stroke="currentColor" stroke-width="2.5" stroke-linecap="butt" />
      <path class="method-plant__leaf" d="M28 80C23 76 18 71 14 66C17 70 22 75 28 80Z" fill="currentColor" opacity="0.92" />
      <path class="method-plant__leaf" d="M28 80C25 77 22 74 20 71C22 73 25 76 28 80Z" fill="currentColor" opacity="0.68" />
    </g>

    <g class="method-plant__cluster method-plant__cluster--2">
      <path class="method-plant__twig" d="M60 78L92 60" stroke="currentColor" stroke-width="2.5" stroke-linecap="butt" />
      <path class="method-plant__leaf" d="M92 60C97 56 102 51 106 46C103 50 98 55 92 60Z" fill="currentColor" opacity="0.92" />
      <path class="method-plant__leaf" d="M92 60C95 57 98 54 100 51C98 53 95 56 92 60Z" fill="currentColor" opacity="0.68" />
    </g>

    <g class="method-plant__cluster method-plant__cluster--3">
      <path class="method-plant__twig" d="M60 58L34 40" stroke="currentColor" stroke-width="2.5" stroke-linecap="butt" />
      <path class="method-plant__leaf" d="M34 40C29 36 24 31 20 26C23 30 28 35 34 40Z" fill="currentColor" opacity="0.92" />
      <path class="method-plant__leaf" d="M34 40C31 37 28 34 26 31C28 33 31 36 34 40Z" fill="currentColor" opacity="0.68" />
    </g>

    <g class="method-plant__cluster method-plant__cluster--4">
      <path class="method-plant__twig" d="M60 42L62 16" stroke="currentColor" stroke-width="2.5" stroke-linecap="butt" />
      <path class="method-plant__leaf" d="M62 16C56 14 52 10 50 6C53 9 57 13 62 16Z" fill="currentColor" opacity="0.88" />
      <path class="method-plant__leaf" d="M62 16C59 10 61 4 62 2C63 4 65 10 62 16Z" fill="currentColor" opacity="0.95" />
      <path class="method-plant__leaf" d="M62 16C68 14 72 10 74 6C71 9 67 13 62 16Z" fill="currentColor" opacity="0.88" />
    </g>
  </svg>
</span>

<style is:global>
  .method-plant {
    @apply inline-flex items-center justify-center text-eco-500;
  }

  .method-plant__svg {
    @apply mx-auto h-52 w-auto overflow-visible sm:h-60 lg:h-64;
  }

  .method-plant__soil,
  .method-plant__pot {
    transform-origin: 60px 128px;
    transform: scale(calc(0.85 + var(--method-progress, 0) * 0.15));
    opacity: calc(0.35 + var(--method-progress, 0) * 0.65);
  }

  .method-plant__stem {
    transform-origin: 60px 118px;
    stroke-dasharray: 82;
    stroke-dashoffset: calc(82px * (1 - min(1, var(--method-progress, 0) * 1.1)));
  }

  .method-plant__cluster {
    opacity: 0;
    transform: scale(0.4);
  }

  .method-plant__cluster--1 {
    transform-origin: 60px 98px;
    --cluster-reveal: clamp(0, (var(--method-progress, 0) - 0.08) / 0.22, 1);
    opacity: var(--cluster-reveal);
    transform: scale(calc(0.45 + var(--cluster-reveal) * 0.55));
  }

  .method-plant__cluster--2 {
    transform-origin: 60px 78px;
    --cluster-reveal: clamp(0, (var(--method-progress, 0) - 0.28) / 0.22, 1);
    opacity: var(--cluster-reveal);
    transform: scale(calc(0.45 + var(--cluster-reveal) * 0.55));
  }

  .method-plant__cluster--3 {
    transform-origin: 60px 58px;
    --cluster-reveal: clamp(0, (var(--method-progress, 0) - 0.48) / 0.22, 1);
    opacity: var(--cluster-reveal);
    transform: scale(calc(0.45 + var(--cluster-reveal) * 0.55));
  }

  .method-plant__cluster--4 {
    transform-origin: 60px 42px;
    --cluster-reveal: clamp(0, (var(--method-progress, 0) - 0.68) / 0.24, 1);
    opacity: var(--cluster-reveal);
    transform: scale(calc(0.45 + var(--cluster-reveal) * 0.55));
  }

  .method-plant__leaf {
    opacity: calc(var(--cluster-reveal, 0) * 0.95);
  }

  .method-plant__twig {
    stroke-dasharray: 37;
    stroke-dashoffset: calc(37px * (1 - var(--cluster-reveal, 0)));
  }

  @media (prefers-reduced-motion: reduce) {
    .method-plant__stem {
      stroke-dashoffset: 0;
    }

    .method-plant__cluster {
      opacity: 1;
      transform: none;
    }

    .method-plant__twig {
      stroke-dashoffset: 0;
    }

    .method-plant__leaf {
      opacity: 1;
    }
  }
</style>
