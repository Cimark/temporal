# EcoPrime — variables de build (Railway → servicio web)
# Copiar a Railway como build args + env en deploy

# Fase 0 (Railway): genera dominio en Networking → copia la URL completa aquí.
# Ej: https://ecoprime-web-production.up.railway.app
# Si no la pones, Railway puede inyectar RAILWAY_PUBLIC_DOMAIN en el build.
PUBLIC_SITE_URL=
PUBLIC_SITE_NAME=EcoPrime
PUBLIC_SITE_TAGLINE=Soluciones ambientales que generan futuro.
PUBLIC_WHATSAPP=51988356603
PUBLIC_CONTACT_EMAIL=info@ecoprime.pe
PUBLIC_PROJECTS_EMAIL=info@ecoprime.pe
PUBLIC_PRODUCTS_EMAIL=info@ecoprime.pe
PUBLIC_LEGAL_NAME=EcoPrime S.A.C.
PUBLIC_COMPANY_RUC=20616126921
PUBLIC_COMPANY_ADDRESS=Av. Javier Prado Este 4200, Santiago de Surco, Lima, Perú

# GA4 — crear propiedad en analytics.google.com
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
PUBLIC_GTM_ID=GTM-XXXXXXX

# Looker Studio — URL embed del dashboard vinculado a GA4
PUBLIC_LOOKER_STUDIO_URL=
PUBLIC_REPORTES_PIN=
